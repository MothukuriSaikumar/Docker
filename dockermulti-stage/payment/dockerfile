# -------- Stage 1: Build --------
FROM python:3.9.25-alpine AS builder

WORKDIR /opt/server

# Install build dependencies (required for some Python packages)
RUN apk add --no-cache \
    build-base \
    gcc \
    musl-dev \
    libffi-dev

# Copy requirements
COPY requirements.txt .

# Install dependencies into custom directory
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# -------- Stage 2: Runtime --------
FROM python:3.9.25-alpine

WORKDIR /opt/server

# Install runtime dependencies (lightweight)
RUN apk add --no-cache libffi

# Create non-root user
RUN addgroup -S roboshop && adduser -S roboshop -G roboshop

# Copy dependencies from builder
COPY --from=builder /install /usr/local

# Copy application files
COPY payment.ini .
COPY payment.py .

# Environment variables (correct format ✅)
ENV CART_HOST=cart \
    CART_PORT=8080 \
    USER_HOST=user \
    USER_PORT=8080 \
    AMQP_HOST=rabbitmq

# Switch user
USER roboshop

EXPOSE 8080

# Start service
CMD ["uwsgi", "--ini", "payment.ini"]

